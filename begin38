#include <iostream>
using namespace std;

int main()
{
double a, M, C;

cout <<"Enter the number that should be converted from kilometers to meters and centimeters ";
cin >> a; //enter km
M = 1000 * a; //from km to meters
C = 100000 * a; //from km to centimeters
cout <<"This is "<< M << " meters" << endl;
cout <<"This is "<< C << " centimeters";

return 0;
}



