#include <iostream>
#include <cmath>

using namespace std;

int main()
{
    double PI = 3.1416;
    double x;
    double angle = 127 * PI / 180;
    
    cout<<"x (x != 0)";
    cin >> x;
    
    double top = 2 * pow(3, x - 2) * sqrt(exp(2*x) * abs(sin(angle + 2*x)));
    double bottom = log(2) / log(3) * abs(x/2);

    double res;
    res = top / bottom;
    
    cout << res;

    return 0;
}
